{
  "name": "@mindattic/eyetracker",
  "version": "0.1.0",
  "description": "Webcam eye tracking: iris and eye-white landmarks to an on-screen gaze point, for the web, Unity and Unreal",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./core": { "types": "./dist/core.d.ts", "import": "./dist/core.js" }
  },
  "files": ["dist", "bridge", "demo", "tracker", "tools", "docs"],
  "bin": { "eyetracker-bridge": "bridge/server.mjs" },
  "scripts": {
    "build": "tsc -p tsconfig.json && node tools/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bridge": "node bridge/server.mjs",
    "start": "npm run build && node bridge/server.mjs --open",
    "fetch-model": "node tools/fetch-model.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.3",
    "selfsigned": "^5.5.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.28.2",
    "three": "^0.187.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.1"
  }
}
